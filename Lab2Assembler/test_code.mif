DEPTH = 1024;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT
BEGIN

000 : 04401001; --LW R2 f R0
001 : 04200800; --LW R1 n R0
002 : 00000000; --NOP
003 : 00000000; --NOP
004 : 20210001; --SUBI R1 R1 1
005 : AC010000; --BEQZ R1 exit
006 : 10E20000; --ADDI R7 R2 0
007 : 11010000; --ADDI R8 R1 0
008 : BC000000; --JAL loop_multiply
009 : 20210001; --SUBI R1 R1 1
00A : B4000000; --J top
00B : 0C423800; --ADD R2 R2 R7
00C : 21080001; --SUBI R8 R8 1
00D : B0080000; --BNEZ R8 loop_multiply
00E : B800F800; --JR R31
00F : 08401001; --SW f R0 R2

