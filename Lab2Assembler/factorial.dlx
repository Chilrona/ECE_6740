; factorial file

.data
n   1   3      
f   1   1   
result   1   0

.text
    LW   R1, n(R0) 
    LW   R2, f(R0)     
    NOP
    SUBI R1, R1, 1   
    NOP 
    NOP
top
    BEQZ R1, exit 
    NOP 
    NOP
    ADDI R7, R2, 0 
    ADDI R8, R1, 0 

    ;XORI R2, R2, 0 

    JAL loop_multiply  
    NOP 
    NOP
    SUBI R1, R1, 1 

    J top
    NOP 
    NOP

; R7 = old total
; R8 = loop counter (i)
; R2 = accumulator (starts at 0)



loop_multiply
       
    SUBI R8, R8, 1
    ADD  R2, R2, R7
    NOP
    BNEZ R8, loop_multiply
    NOP 
    NOP

loopdone
    JR R31           
    NOP 
    NOP

exit
    SW f(R0), R2   
    NOP 
    NOP       