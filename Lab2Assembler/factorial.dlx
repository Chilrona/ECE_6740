; factorial file

.data
n   1   4      ; compute 4!
f   1   1      ; initial total = 1

.text
    LW   R0, f     ; total = 1
    LW   R1, n     ; i = n

top
    BEQZ R1, exit 

    ADDI R7, R0, 0 
    ADDI R8, R1, 0 

    XORI R0, R0, 0 

    JAL multiply  

    SUBI R1, R1, 1 ; i--

    J top


; R7 = old total
; R8 = loop counter (i)
; R0 = accumulator (starts at 0)



multiply
    BEQZ R8, loopdone

loop
    ADD  R0, R0, R7   ; R0 += R7
    SUBI R8, R8, 1
    BNEZ R8, loop

loopdone
    JR R31           


exit
    SW f, R0          