;baseline of factorial 
;not yet done
	
	.data
	
n   1	4 ;this is the value we are doing the factorial on 4! 
f	1	1 ;this is where we put the final result

	.text
	
	LW	    R0, f
	LW		R1, n
	
top
;pseudocode for factorial
;start by initializing total at 1
    LW 
;load in our factorial value(ex 4! we load in 4)
    LW 
;start a loop that checks for if our loop variable is zero i is (R1)
factorial
;we have a special variable that we load in the temp value of total

;check if the I got down to zero 
    BEQZ R1, exit
;decrease the value of i 
    SUBI R1, R1, 1
;another loop that loops j(R8) through until (j>i) this will actually be our multiply function using Jump and Link
    JAL 
;add the temp value (R7) to the total (R0)
    ADD R0, R0, R7
    BNEZ R8, factorial ;if we got down to zero we want to go back to the top of the loop
    SUBI R8, R8, 1
    JR
;end program
	
exit
	SW		f(R0), R3
	