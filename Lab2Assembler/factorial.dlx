; factorial file

.data
n   1   6
f   1   1

.const
s1 37 !margorp lairotcaf XLD eht ot emocleW
s2 3 = ! 

.text
    ADDI R21, R0, 37
print_loop:
    LW R22, s1(R21)
    BEQZ R21, end_loop
    PCH R22
    SUBI R21, R21, 1
    J print_loop
end_loop:

    LW   R2, f(R0)
    LW   R1, n(R0)
    PD   R1 

    ADDI R21, R0, 4
second_loop:
    LW R22, s2(R21)
    BEQZ R21, second_done
    PCH R22
    SUBI R21, R21, 1
    J second_loop
second_done:
    
    SUBI R1, R1, 1

top:
    BEQZ R1, exit
    ADDI R7, R2, 0
    ADDI R8, R1, 0
    JAL loop_multiply
    SUBI R1, R1, 1
    J top

; R7 = old total
; R8 = loop counter (i)
; R2 = accumulator (starts at 0)

loop_multiply:
    ADD  R2, R2, R7
    SUBI R8, R8, 1
    BNEZ R8, loop_multiply

loopdone:
    JR R31

exit:
    PDU R2
    SW f(R0), R2
    PCH R8
    ; Adding a test line here for scanning
    GD R6
    GDU R20