.data
	n		1	0
    f       1   0

.const
	str1	25	"Enter a negative number: "
    str2    13  "You entered: "
		
.text

top

    ADD		R2, R0, R0

printstr1
	LW		R3, str1(R2)
	PCH		R3
	ADDI	R2, R2, 1
	SLTI	R1, R2, 25
	BNEZ	R1, printstr1
			
	;get integer n
	GD		R22

    ADD		R2, R0, R0

    ;newline 
    ADDI R23, R0, 10
    PCH R23
    ADDI R18, R0, 13
    PCH R18

printstr2
	LW		R3, str2(R2)
	PCH		R3
	ADDI	R2, R2, 1
	SLTI	R1, R2, 13
	BNEZ	R1, printstr2

    PD      R22

    ;newline 
    ADDI R23, R0, 10
    PCH R23
    ADDI R18, R0, 13
    PCH R18 

    J top

done
    J done