library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity DE10_LITE_Lab1_tb is
end DE10_LITE_Lab1_tb;

architecture test of DE10_LITE_Lab1_tb is

	component DE10_LITE_Lab1
		port(
			clk : in std_logic;
			rst_l : in std_logic;
			out1 : out std_logic_vector(9 downto 0) --This is for our LEDs
			);
	end component;
	
	signal clk : std_logic := '0';
	signal rst_l: std_logic := '1';
	signal out1 : std_logic_vector(9 downto 0) := (others=> '0'); --This is for our LEDs
	
	constant CLK_PERIOD : time := 10 ns;
	
	begin

	-- Instantiate the Unit Under Test (UUT)
	UUT : DE10_LITE_Lab1
		port map (
			clk => clk,
			rst_l => rst_l,
			out1 => out1
	);
	
	clk_process : process
	begin
		clk <= '0';
		wait for CLK_PERIOD/2;
		clk <= '1';
		wait for CLK_PERIOD/2;
	end process;
	
	process
	begin
	
		rst_l <= '0';
		wait for CLK_PERIOD * 100;
		
		rst_l <= '1';
		wait for CLK_PERIOD * 100;
		
		
	end process;
end test;	