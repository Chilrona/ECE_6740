#============================================================
# Build by Terasic System Builder
#============================================================

set_global_assignment -name FAMILY "MAX 10 FPGA"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY "DE10_LITE_Lab1"
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 16.0.0
set_global_assignment -name LAST_QUARTUS_VERSION "24.1std.0 Lite Edition"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "09:33:13 SEPTEMBER 05,2025"
set_global_assignment -name DEVICE_FILTER_PACKAGE FBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 484
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 7
set_global_assignment -name SDC_FILE DE10_LITE_Lab1.SDC

#============================================================
# CLOCK
#============================================================
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADC_CLK_10
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK2_50
set_location_assignment PIN_N5 -to ADC_CLK_10
set_location_assignment PIN_P11 -to clk
set_location_assignment PIN_N14 -to MAX10_CLK2_50

#============================================================
# KEY
#============================================================
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to rst_l
set_instance_assignment -name IO_STANDARD "3.3 V SCHMITT TRIGGER" -to button1
set_location_assignment PIN_B8 -to rst_l
set_location_assignment PIN_A7 -to button1

#============================================================
# LED
#============================================================
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to out1[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to out1[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to out1[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to out1[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to out1[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to out1[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to out1[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to out1[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to out1[8]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to out1[9]
set_location_assignment PIN_A8 -to out1[0]
set_location_assignment PIN_A9 -to out1[1]
set_location_assignment PIN_A10 -to out1[2]
set_location_assignment PIN_B10 -to out1[3]
set_location_assignment PIN_D13 -to out1[4]
set_location_assignment PIN_C13 -to out1[5]
set_location_assignment PIN_E14 -to out1[6]
set_location_assignment PIN_D14 -to out1[7]
set_location_assignment PIN_A11 -to out1[8]
set_location_assignment PIN_B11 -to out1[9]

#============================================================
# End of pin assignments by Terasic System Builder
#============================================================


set_global_assignment -name VHDL_FILE DE10_LITE_Lab1.vhd
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name VHDL_FILE DE10_LITE_Lab1_tb.vhd
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top