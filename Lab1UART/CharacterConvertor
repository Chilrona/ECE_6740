library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;


entity CharacterConvertor is
		port
			(
				c1 in : std_logic;
				KEY in : std_logic_vector (1 downto 0);
				InChar in : unsigned (7 downto 0);
				OutChar out : unsigned (7 downto 0)
			);
		end entity CharacterConvertor;
		
		architecture Behavioral of CharacterConvertor is
		
		
		begin
		
		process(c1, KEY(0))
		begin
			if x"60" < InChar < x"7B" then
				OutChar <= InChar - x"20";
			elsif x"40" < InChar < x"5B" then
				OutChar <= InChar +x"20";
			else
				OutChar <= x"45";
			end if;
		
		end process;
		
		end Behavioral;